<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <PlatformTarget>x64</PlatformTarget>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ApplicationIcon>CPURacer.ico</ApplicationIcon>
    <RootNamespace>CPURacer.App</RootNamespace>
    <AssemblyName>CPURacer</AssemblyName>
    <Version>0.4.0</Version>
    <FileVersion>0.4.0.0</FileVersion>
    <InformationalVersion>0.4.0</InformationalVersion>
    <Product>CPURacer</Product>
    <Authors>CPURacer</Authors>
    <Description>Race on the Windows Task Manager CPU chart.</Description>
  </PropertyGroup>

  <ItemGroup>
    <None Include="CPURacer.ico" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\CPURacer.Overlay\CPURacer.Overlay.csproj" />
    <ProjectReference Include="..\CPURacer.Taskmgr\CPURacer.Taskmgr.csproj" />
    <ProjectReference Include="..\CPURacer.Capture\CPURacer.Capture.csproj" />
    <ProjectReference Include="..\CPURacer.Game\CPURacer.Game.csproj" />
    <ProjectReference Include="..\CPURacer.Native\CPURacer.Native.csproj" />
  </ItemGroup>

</Project>
