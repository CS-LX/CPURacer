<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.20348.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Platforms>AnyCPU;x64;x86</Platforms>
    <PlatformTarget>$(CpuArch)</PlatformTarget>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <OutputPath>bin\$(Configuration)\net8.0-windows10.0.20348.0\$(CpuArch)\</OutputPath>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ApplicationIcon>CPURacer.ico</ApplicationIcon>
    <RootNamespace>CPURacer.App</RootNamespace>
    <AssemblyName>CPURacer</AssemblyName>
    <Version>1.1.0.0</Version>
    <FileVersion>1.1.0.0</FileVersion>
    <InformationalVersion>1.1.0.0</InformationalVersion>
    <Product>CPURacer</Product>
    <Authors>CPURacer</Authors>
    <Description>Race on the Windows Task Manager CPU chart.</Description>
  </PropertyGroup>

  <ItemGroup>
    <None Include="CPURacer.ico" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\CPURacer.Overlay\CPURacer.Overlay.csproj" />
    <ProjectReference Include="..\CPURacer.Taskmgr\CPURacer.Taskmgr.csproj" />
    <ProjectReference Include="..\CPURacer.Capture\CPURacer.Capture.csproj" />
    <ProjectReference Include="..\CPURacer.Game\CPURacer.Game.csproj" />
    <ProjectReference Include="..\CPURacer.Native\CPURacer.Native.csproj" />
    <ProjectReference Include="..\CPURacer.Localization\CPURacer.Localization.csproj" />
  </ItemGroup>

  <!-- Win desktop does not need package RID folders (e.g. System.Text.*.browser). -->
  <Target Name="StripUnusedRuntimeFolders"
          AfterTargets="CopyFilesToOutputDirectory"
          Condition="'$(Configuration)' == 'Release'">
    <PropertyGroup>
      <_AppOutDir>$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)\$(OutputPath)'))</_AppOutDir>
    </PropertyGroup>
    <RemoveDir Directories="$(_AppOutDir)runtimes" Condition="Exists('$(_AppOutDir)runtimes')" />
  </Target>

</Project>
